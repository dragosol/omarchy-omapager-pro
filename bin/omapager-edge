#!/usr/bin/env python3
"""Watch one touchpad for the right-edge reveal swipe.

Given the device node by omapager-run-helper, which found it and is the only
thing allowed to choose it. Prints "ready" once the pad is open, then
begin / move <p> / end <p> <v> for each swipe, one per line, for the shell.
"""
import os
import sys

from omapager_edge import watch


def emit(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def main(argv):
    if len(argv) != 1 or not argv[0].startswith("/dev/input/event"):
        return 2
    try:
        watch(argv[0], emit)
    except OSError:
        # The pad went away - suspend, a replug. The shell starts us again.
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
